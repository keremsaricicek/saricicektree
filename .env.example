# Your purchased domain; bare hostname, no protocol.
SITE_DOMAIN=family.example.com
# For local execution only:
APP_ORIGIN=http://localhost:3000
PORT=3000
DATA_DIR=./data

# Optional AI photo restoration; server-only secret, never sent to the browser.
OPENAI_API_KEY=
