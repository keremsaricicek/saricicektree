{
  // Type checking for plain JavaScript (checkJs); no build output. Covers the Node server,
  // the Cloudflare Worker and their shared modules; the browser scripts share one global scope and are checked by ESLint.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable", "dom.asynciterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "worker/**/*.mjs"]
}
